# AI credentials are only read by the server. Never put real values in Git.
# For Alibaba Cloud Model Studio/Qwen in Beijing, use the OpenAI-compatible URL
# shown in the Model Studio console. The shared Beijing URL is shown below as
# a starting point; a workspace-specific URL may also be provided by the console.
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# Legacy names remain supported so an existing OpenAI deployment does not break.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5

# Production uses Nginx as the public entry point. Keep Express on localhost.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Learning content lives outside the public application repository.
# Replace this placeholder with the absolute path of the cloned private repo.
LIBRARY_ROOT=/absolute/path/to/learn-everything
WRITE_SAFETY_ROOT=.interactive-study-boox

# P1 Git sync is opt-in. The configured library root must be the Git repository root.
GIT_SYNC_ENABLED=false
GIT_SYNC_REMOTE=origin
GIT_SYNC_BRANCH=
